# Content Security Policy: everything the app needs now comes from its own
# origin (NFR-009). Sign-in is a top-level redirect to the provider and back —
# no third-party script, iframe or XHR — and avatars are served by the Worker
# from R2, so `img-src 'self'` covers them.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
