{
  "name": "quadro-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run && npm run test:worker",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "bench": "vite-node test/strength.bench.ts --",
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "db:local": "wrangler d1 execute quadro --local --file worker/schema.sql",
    "build": "npm run typecheck && vite build && node scripts/seo-build.mjs",
    "preview": "vite preview",
    "test:worker": "vitest run --config test/worker/vitest.config.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
