{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quadro-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quadro",
      "database_id": "50ec5486-b419-46da-89d6-0f99f52ce947"
    }
  ],

  // The API shares the hostname with the Pages site; a Worker route takes
  // precedence over Pages for the paths it matches, so /api/* lands here and
  // everything else is served as the SPA.
  "routes": [
    { "pattern": "acgame.win/api/*", "zone_name": "acgame.win" }
  ],

  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "quadro-avatars"
    }
  ],

  // ~midnight New York year-round; deletes rows older than 90 days (BR-014).
  "triggers": { "crons": ["0 5 * * *"] },

  "vars": {
    // Public, non-secret configuration. Every auth credential
    // (BETTER_AUTH_SECRET, the three providers' client ids and secrets) is a
    // Worker secret and never appears here (NFR-010).
    "ALLOWED_ORIGIN": "https://acgame.win"
  }
}
